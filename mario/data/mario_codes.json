 "game_events": {
  "0x3861": {
   "name": "conto alla rovescia a un passo al secondo quando Mario resta fermo fuori dal livello: 5→1, poi 8→1 ripetuto (11/10 17:07–17:08; confermato il 14/10 dal passo 'sonno' di re-checks: 5→1, 8→1, 8→1 in 31 s); si interrompe se Mario viene mosso (0x3862 = 0). Non è un contatore di monete: il totale è 0x386B",
   "source": "dal vivo",
   "verified": "14/10/2026",
   "hypothesis": true
  },
  "0x3862": {
   "name": "stato di attività: 0 a ogni movimento, basetta letta o sollevamento (azzera l'inattività); 2 alla fine di ogni conto alla rovescia 5→1 da fermo (anche il 14/10); 4 alla connessione (12/10 17:39) e 3 s prima della sequenza di fine livello (12/10 18:26:20)",
   "source": "dal vivo",
   "verified": "14/10/2026",
   "hypothesis": true
  },
  "0x3857": {
   "name": "1 e 0 attorno alle letture del colore rosso (lava) con urti e scosse (11/10 17:07:31–36): forse danno subito o reazione alla lava; il 14/10 solo 0, durante salti e cambi di colore senza rosso; da riprovare appoggiando Mario sul rosso senza muoverlo",
   "source": "dal vivo",
   "verified": "14/10/2026",
   "hypothesis": true
  },
  "0x3866": {
   "name": "0 insieme a 0x1802 = 2 alla fine dei conti alla rovescia con Mario fermo (11/10 17:08:37, poi 93 s senza alcun gesto; 14/10 dopo 32 s da fermo): addormentamento?; 1 insieme a 0x1802 = 1 quando Mario viene ripreso in mano (11/10 17:10:10, 14/10): risveglio?",
   "source": "dal vivo",
   "verified": "14/10/2026",
   "hypothesis": true
  },
  "0x3803": {
   "name": "0 subito dopo la lettura di molte basette (inizio di un'animazione o di un suono?), 100 qualche secondo dopo e nella sequenza di fine livello (conclusa?)",
   "source": "dal vivo",
   "verified": "12/10/2026",
   "hypothesis": true
  },
  "0x200E": {
   "name": "valore 2 (11/10 17:10:21) mentre Mario veniva fatto ruotare e invertire sopra i colori nougat, bianco e nero; significato ignoto",
   "source": "dal vivo",
   "verified": "12/10/2026",
   "hypothesis": true
  },
  "0x1802": {
   "name": "2 con 0x3866 = 0 quando Mario, fermo, finisce i conti alla rovescia (sonno?); 1 con 0x3866 = 1 quando viene ripreso in mano (risveglio?) (11/10, confermato il 14/10)",
   "source": "dal vivo",
   "verified": "14/10/2026",
   "hypothesis": true
  },
  "0x0000": {
   "name": "evento nullo 0x00/0x00",
   "source": "dal vivo",
   "verified": "12/10/2026",
   "hypothesis": true
  },
  "0x0113": {
   "name": "basetta letta: il valore è il codice del barcode (visto 184 = 0xB8 Start Mario)",
   "source": "dal vivo",
   "verified": "12/10/2026",
   "hypothesis": true
  },
  "0x1801": {
   "name": "livello in corso: 1 alla lettura dello Start (12/10 18:09:14, 14/10 19:00:51, insieme all'azzeramento delle monete 0x386B = 0), 0 circa 9 s dopo la fine del livello; rileggere lo Start durante il livello non lo fa ripartire",
   "source": "dal vivo",
   "verified": "14/10/2026",
   "hypothesis": true
  },
  "0x1803": {
   "name": "fase del livello: 1 alla lettura dello Start; 4 a 45 s dallo Start, cioè negli ultimi 15 s (in tutte e quattro le sessioni la fine è arrivata esattamente 15 s dopo il 4: 12/10 17:33:14, 18:10:14, 18:26:23, 14/10 19:01:50); 3 alla fine del livello (con 0x3004 = 601); 0 al ritorno fuori dal livello",
   "source": "dal vivo",
   "verified": "14/10/2026",
   "hypothesis": true
  },
  "0x2009": {
